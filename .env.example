# ============================================================
# GUES ENERGY + SARL — Variables d'environnement (EXEMPLE)
# Copiez ce fichier vers `.env.local` et remplissez vos valeurs.
# Ne JAMAIS committer les vraies valeurs.
# ============================================================

# --- SQL Server (source de vérité partagée GesCom / Kobson Shop / GUES ENERGY) ---
# Format Prisma SQL Server : les identifiants vont en paramètres après le ";"
# (encodage URL requis pour les caractères spéciaux du mot de passe : % -> %25, = -> %3D)
DATABASE_URL=sqlserver://HOST:1433;database=DBNAME;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=GUES ENERGY + SARL

# --- Tenant / Boutique GesCom (NE PAS modifier sans raison) ---
GUES_TENANT_ID=24
GUES_BOUTIQUE_ID=3

# --- WhatsApp (numéro au format international sans +, ex: 22507000000) ---
WHATSAPP_NUMBER=

# --- Logistique ---
# Frais de livraison fixes (FCFA) et seuil de gratuité (FCFA)
SHIPPING_FEE_DEFAULT=2000
FREE_SHIPPING_THRESHOLD=25000

# --- Sécurité API ---
# Clé partagée protégeant les endpoints d'écriture sensibles (optionnel, fortement recommandé)
GUES_API_KEY=

# --- Divers ---
# NEXTAUTH_SECRET=change-me
# LOG_LEVEL=info